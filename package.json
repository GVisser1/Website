{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "preview": "pnpm build && pnpm exec vp preview --port 5173 --strictPort",
    "build": "tsc && tsx ./scripts/generateSitemap.ts && vp build && pnpm build:prerender",
    "build:prerender": "vp build --ssr src/entryServer.tsx --outDir node_modules/.prerender --emptyOutDir && tsx ./scripts/prerender.ts",
    "test": "vp test",
    "test:ui": "vp test --ui --coverage",
    "test:e2e": "playwright test",
    "test:e2e-ui": "playwright test --ui",
    "test:e2e-report": "exec playwright show-report src/e2e-tests/test-reports",
    "test:e2e-docker": "./scripts/e2eDocker.sh",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.169.0",
    "@vitejs/plugin-react": "6.3.0",
    "lodash-es": "4.18.1",
    "next-themes": "0.4.6",
    "oxc-transform-react": "0.156.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "clsx": "2.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
