# Netlify response headers, see https://docs.netlify.com/routing/headers/

# Vite puts a content hash in every file name under /assets, so a changed file always gets a new URL
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing should embed the site in a frame (clickjacking)
  X-Frame-Options: DENY
  # Pages opened from here (or that open this site) can't reach back into this window
  Cross-Origin-Opener-Policy: same-origin
  # Netlify already sends HSTS for a year; also cover subdomains
  Strict-Transport-Security: max-age=31536000; includeSubDomains
